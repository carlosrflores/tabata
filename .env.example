# ============================================================
# Tabata Tuesday — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# Supabase — from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Your deployed URL (used for internal API calls during build)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# A random secret string — gates /api/debug, /api/members and /api/admin/*
# Generate one with: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# Fine-grained GitHub PAT for this repo with "Actions: Read and write".
# Lets the /admin "Sync" buttons queue the GitHub Actions sync workflow.
GITHUB_DISPATCH_TOKEN=github_pat_your-token-here
